PRGNAM=oolite
set -e
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
cd $SCRIPT_DIR

################################
# check versions               #
################################
# Latest stable release (gh skips prereleases). Note the tag (e.g. 1.92.1.0)
# differs from the version in the source asset name (oolite-source-1.92.1.zip),
# so take the version from the asset itself.
TAG=$(gh release view -R OoliteProject/oolite --json tagName --jq '.tagName')
TARBALL=$(gh release view "$TAG" -R OoliteProject/oolite --json assets --jq '.assets[].name' \
    | grep -E '^oolite-source-.*\.zip$' | head -n1)
if [ -z "$TARBALL" ]
then
    echo "No oolite-source-*.zip asset in release $TAG, aborting..."
    return 1 2>/dev/null || exit 1
fi
REALVERSION=${TARBALL#oolite-source-}
REALVERSION=${REALVERSION%.zip}
NEWVERSION=${REALVERSION//-/_}

URL="https://github.com/OoliteProject/oolite/releases/download/$TAG/$TARBALL"

VERSION=`cat version`
if [ "$VERSION" = "$NEWVERSION" ]
then
    echo -n "is at version $VERSION"
    export RET0=""
else
    ################################
    # check for testonly parameter #
    ################################
    if [ "$ARG0" = "TESTONLY" ]
    then
        echo -n "has a new version $NEWVERSION"
        export RET0=$NEWVERSION
        return
    fi
    ################################
    # download source              #
    ################################
    # The source zip bundles every git submodule (SpiderMonkey, deps,
    # binary resources), so it is the only file the build needs.
    rm -f ./$TARBALL
    wget $URL
    if [ ! -f ./$TARBALL ]
    then
        echo "File $TARBALL not found, aborting..."
        return 1 2>/dev/null || exit 1
    fi
    # delete old sources and place new one
    rm -f ../*.tar.bz2 ../oolite-source-*.zip 2> /dev/null
    mv $TARBALL ..

    ################################
    # write templates              #
    ################################
    MD5=`md5sum ../$TARBALL | cut -d " " -f 1`

    sed -e "s/_version_/${REALVERSION}/g" \
        -e "s/_tag_/${TAG}/g" \
        -e "s/_md5_/${MD5}/g" \
        $SCRIPT_DIR/template/${PRGNAM}.info.template > ../${PRGNAM}.info

    sed -e "s/_version_/${REALVERSION}/g" \
        $SCRIPT_DIR/template/${PRGNAM}.SlackBuild.template > ../${PRGNAM}.SlackBuild

    chmod 644 ../${PRGNAM}.SlackBuild
    echo "$NEWVERSION" > version
    echo -n "has a new version $NEWVERSION"
    export RET0=$NEWVERSION
fi
